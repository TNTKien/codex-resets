---
import '../styles/global.css';
import ResetDashboard from '../components/ResetDashboard';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Community tracker for public Codex usage-limit reset announcements." />
  <meta name="theme-color" content="#241e18" />
  <title>Codex Resets</title>
</head>
<body>
  <main class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="/">Codex Resets</a>
      <nav aria-label="Languages"><span>English</span><span>简体中文</span><span>繁體中文</span><span>日本語</span><span>한국어</span></nav>
    </header>

    <section class="intro">
      <p>We watch <a href="https://x.com/thsottiaux" target="_blank" rel="noreferrer">@thsottiaux</a> for Codex reset announcements, so you don't have to.</p>
    </section>

    <ResetDashboard client:load />

    <footer>
      <p>Data is read from the public codex-resets.com API. This independent clone is not affiliated with OpenAI and cannot reset an account.</p>
      <a href="https://github.com/TNTKien/codex-resets" target="_blank" rel="noreferrer">GitHub ↗</a>
    </footer>
  </main>
</body>
</html>
