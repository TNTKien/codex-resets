---
import '../styles/global.css';
import ResetDashboard from '../components/ResetDashboard';
---
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Trạm radar reset Codex — canh quota, ghi lịch sử, khấn khi cần." />
  <meta name="theme-color" content="#0b0d14" />
  <title>Codex Reset Arcade</title>
  <script is:inline>
    (() => {
      const key = 'codex-resets-theme';
      const saved = localStorage.getItem(key);
      const theme = saved === 'light' || saved === 'dark'
        ? saved
        : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0b0d14' : '#fff6d8');
    })();
  </script>
</head>
<body>
  <div class="scanlines" aria-hidden="true"></div>
  <main class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Codex Reset Arcade">
        <span class="wordmark-mark" aria-hidden="true">CR</span>
        <span class="wordmark-copy">
          <strong>CODEX RESET</strong>
          <small>ARCADE / VI</small>
        </span>
      </a>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Đổi giao diện sáng tối" aria-pressed="false">
        <span class="theme-toggle-icon" aria-hidden="true">◐</span>
        <span class="theme-toggle-label">MODE</span>
      </button>
    </header>

    <section class="intro arcade-marquee">
      <span class="marquee-dot" aria-hidden="true"></span>
      <p>RADAR đang canh <a href="https://x.com/thsottiaux" target="_blank" rel="noreferrer">@thsottiaux</a>. Có reset là bảng điểm nhảy. Chưa reset thì… bấm nút đỏ và gửi tín hiệu lên vũ trụ.</p>
      <span class="marquee-tag">ONLINE</span>
    </section>

    <ResetDashboard client:load />

    <footer>
      <p>DATA FEED: codex-resets.com · FAN PROJECT · không thuộc OpenAI · nút đỏ không có quyền năng pháp lý với quota.</p>
      <a href="https://github.com/TNTKien/codex-resets" target="_blank" rel="noreferrer">SOURCE.CODE →</a>
    </footer>
  </main>

  <script is:inline>
    (() => {
      const key = 'codex-resets-theme';
      const root = document.documentElement;
      const button = document.getElementById('theme-toggle');
      if (!(button instanceof HTMLButtonElement)) return;
      const label = button.querySelector('.theme-toggle-label');
      const meta = document.querySelector('meta[name="theme-color"]');
      const paint = () => {
        const dark = root.dataset.theme === 'dark';
        button.setAttribute('aria-pressed', String(dark));
        if (label) label.textContent = dark ? 'NIGHT' : 'DAY';
        if (meta) meta.setAttribute('content', dark ? '#0b0d14' : '#fff6d8');
      };
      paint();
      button.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem(key, root.dataset.theme);
        paint();
      });
    })();
  </script>
</body>
</html>
