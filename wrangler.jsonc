{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-resets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BEG_COUNTER", "class_name": "BegCounter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BegCounter"] }
  ]
}
